
from OpenGL.GL import *
from OpenGL.GLU import *
from OpenGL.GLUT import *
import math, random, sys

W, H = 1000, 700
angle, speed, zoom, cam = 0, 0.4, 20, 0
paused = False

# Six major moons
moons = [
    ("Mimas", 4.2, .13, 2, (.7,.7,.7)),
    ("Enceladus", 4.9, .16, 1.7, (.8,.9,1)),
    ("Tethys", 5.8, .19, 1.4, (.7,.8,.9)),
    ("Dione", 6.8, .22, 1.1, (.8,.8,.7)),
    ("Rhea", 8, .25, .9, (.8,.75,.65)),
    ("Titan", 10, .38, .6, (.9,.65,.3))
]

# 287 additional moons and 500 stars
random.seed(10)
minor = [(random.uniform(5,12), random.uniform(0,360),
          random.uniform(.5,2.2), random.uniform(-.3,.3))
         for i in range(287)]

stars = [(random.uniform(-35,35), random.uniform(-25,25),
          random.uniform(-35,35)) for i in range(500)]


def text(x,y,s):
    glColor3f(1,1,1)
    glRasterPos2f(x,y)
    for c in s:
        glutBitmapCharacter(GLUT_BITMAP_HELVETICA_18,ord(c))


def sphere(radius,color):
    glColor3f(*color)
    glutSolidSphere(radius,20,20)


def draw_saturn():
    glPushMatrix()
    glRotatef(angle,0,1,0)

    colors = [(0.78,.68,.49),(.88,.79,.61),
              (.72,.62,.45),(.91,.83,.68)]

    for i in range(40):
        lat1 = -math.pi/2 + math.pi*i/40
        lat2 = lat1 + math.pi/40
        glBegin(GL_QUAD_STRIP)

        for j in range(81):
            lon = 2*math.pi*j/80
            for lat in (lat1,lat2):
                x = 2*math.cos(lat)*math.cos(lon)
                y = 2*math.sin(lat)
                z = 2*math.cos(lat)*math.sin(lon)
                glColor3f(*colors[i%4])
                glNormal3f(x/2,y/2,z/2)
                glVertex3f(x,y,z)
        glEnd()

    glPopMatrix()


def draw_rings():
    glPushMatrix()
    glRotatef(27,1,0,0)
    glRotatef(-12,0,0,1)
    glDisable(GL_LIGHTING)

    rings = [(2.5,2.9,(.55,.43,.28)),
             (2.9,3.4,(.82,.73,.55)),
             (3.65,4.1,(.75,.65,.47)),
             (4.1,4.5,(.55,.45,.32)),
             (4.5,4.9,(.78,.69,.52))]

    for inner,outer,color in rings:
        glColor3f(*color)
        glBegin(GL_QUAD_STRIP)
        for i in range(361):
            a = math.radians(i)
            x,z = math.cos(a),math.sin(a)
            glVertex3f(inner*x,0,inner*z)
            glVertex3f(outer*x,0,outer*z)
        glEnd()

    glEnable(GL_LIGHTING)
    glPopMatrix()


def draw_orbits():
    glDisable(GL_LIGHTING)
    glPushMatrix()
    glRotatef(27,1,0,0)
    glColor3f(.25,.28,.38)

    for name,r,size,speed,color in moons:
        glBegin(GL_LINE_LOOP)
        for i in range(100):
            a = 2*math.pi*i/100
            glVertex3f(r*math.cos(a),0,r*math.sin(a))
        glEnd()

    glPopMatrix()
    glEnable(GL_LIGHTING)


def draw_moons():
    glPushMatrix()
    glRotatef(27,1,0,0)

    # Six major moons
    for name,r,size,sp,color in moons:
        a = math.radians(angle*sp)
        glPushMatrix()
        glTranslatef(r*math.cos(a),0,r*math.sin(a))
        sphere(size,color)
        glPopMatrix()

    # 287 additional moons
    glDisable(GL_LIGHTING)
    glPointSize(3)
    glColor3f(.9,.9,.8)
    glBegin(GL_POINTS)

    for r,phase,sp,h in minor:
        a = math.radians(phase+angle*sp)
        glVertex3f(r*math.cos(a),h,r*math.sin(a))

    glEnd()
    glEnable(GL_LIGHTING)
    glPopMatrix()


def draw_stars():
    glDisable(GL_LIGHTING)
    glPointSize(2)
    glColor3f(.8,.85,1)
    glBegin(GL_POINTS)
    for p in stars:
        glVertex3f(*p)
    glEnd()
    glEnable(GL_LIGHTING)


def lighting():
    glEnable(GL_LIGHTING)
    glEnable(GL_LIGHT0)
    glLightfv(GL_LIGHT0,GL_POSITION,(10,10,10,1))
    glLightfv(GL_LIGHT0,GL_DIFFUSE,(1,1,1,1))
    glLightfv(GL_LIGHT0,GL_AMBIENT,(.35,.35,.35,1))
    glEnable(GL_COLOR_MATERIAL)
    glColorMaterial(GL_FRONT_AND_BACK,GL_AMBIENT_AND_DIFFUSE)


def hud():
    glDisable(GL_LIGHTING)
    glDisable(GL_DEPTH_TEST)
    glMatrixMode(GL_PROJECTION)
    glPushMatrix()
    glLoadIdentity()
    gluOrtho2D(0,W,0,H)
    glMatrixMode(GL_MODELVIEW)
    glPushMatrix()
    glLoadIdentity()

    text(25,H-35,"SATURN 3D SIMULATION")
    text(25,H-65,"TOTAL MOONS: 293")
    text(25,H-90,"Major: 6 | Additional: 287")
    text(25,70,"SPACE: Pause | +/-: Zoom")
    text(25,40,"ARROWS: Camera / Speed")
    text(25,15,"Zoom: "+str(zoom))

    if paused:
        text(W-120,H-35,"PAUSED")

    glPopMatrix()
    glMatrixMode(GL_PROJECTION)
    glPopMatrix()
    glMatrixMode(GL_MODELVIEW)
    glEnable(GL_DEPTH_TEST)
    glEnable(GL_LIGHTING)


def display():
    glClear(GL_COLOR_BUFFER_BIT|GL_DEPTH_BUFFER_BIT)
    glLoadIdentity()

    x = zoom*math.sin(math.radians(cam))
    z = zoom*math.cos(math.radians(cam))
    gluLookAt(x,zoom*.42,z,0,0,0,0,1,0)

    lighting()
    draw_stars()
    draw_orbits()
    draw_rings()
    draw_moons()
    draw_saturn()
    hud()
    glutSwapBuffers()


def update(v):
    global angle
    if not paused:
        angle = (angle+speed)%360
    glutPostRedisplay()
    glutTimerFunc(16,update,0)


def keyboard(key,x,y):
    global paused,zoom
    if key == b' ':
        paused = not paused
    elif key in (b'+',b'='):
        zoom = max(7,zoom-1)
    elif key in (b'-',b'_'):
        zoom = min(40,zoom+1)
    elif key == b'\x1b':
        sys.exit()
    glutPostRedisplay()


def special(key,x,y):
    global cam,speed
    if key == GLUT_KEY_LEFT:
        cam -= 5
    elif key == GLUT_KEY_RIGHT:
        cam += 5
    elif key == GLUT_KEY_UP:
        speed = min(3,speed+.1)
    elif key == GLUT_KEY_DOWN:
        speed = max(.1,speed-.1)
    glutPostRedisplay()


def mouse(button,direction,x,y):
    global zoom
    zoom = max(7,min(40,zoom-direction))
    glutPostRedisplay()


def reshape(w,h):
    global W,H
    W,H = w,max(h,1)
    glViewport(0,0,W,H)
    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    gluPerspective(45,W/H,1,100)
    glMatrixMode(GL_MODELVIEW)


def main():
    glutInit()
    glutInitDisplayMode(GLUT_DOUBLE|GLUT_RGB|GLUT_DEPTH)
    glutInitWindowSize(W,H)
    glutCreateWindow(b"Saturn 3D - 293 Moons")

    glClearColor(.005,.008,.025,1)
    glEnable(GL_DEPTH_TEST)
    glEnable(GL_BLEND)
    glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA)

    glutDisplayFunc(display)
    glutReshapeFunc(reshape)
    glutKeyboardFunc(keyboard)
    glutSpecialFunc(special)

    try:
        glutMouseWheelFunc(mouse)
    except:
        pass

    glutTimerFunc(16,update,0)
    glutMainLoop()


main()
